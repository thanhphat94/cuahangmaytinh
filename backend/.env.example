# Server
PORT=5000
NODE_ENV=development

# JWT — generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m

# Refresh Token — generate tương tự JWT_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL (CORS)
CLIENT_URL=http://localhost:3000
# Production: CLIENT_URL=https://your-site.pages.dev,https://www.your-domain.com

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tinhocnhuy"

# Email (Gmail hoặc SMTP tuỳ chỉnh)
# Gmail: bật 2FA rồi tạo App Password tại https://myaccount.google.com/apppasswords
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password_16_chars
# SMTP tuỳ chỉnh (bỏ comment nếu không dùng Gmail):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Local AI — Ollama
# Ollama phải chạy trên máy mà backend có thể truy cập.
# Nếu backend chạy cùng máy với Ollama: giữ mặc định bên dưới.
# Nếu backend chạy trong Docker/VM: đổi 127.0.0.1 thành host Ollama mà backend truy cập được.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_TIMEOUT_MS=180000

# Cloudinary (bỏ trống để dùng local disk khi dev)
# Đăng ký miễn phí tại https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Backend public URL (dùng cho VNPay/MoMo callback)
BACKEND_URL=http://localhost:5000

# VNPay sandbox — đăng ký tại https://sandbox.vnpayment.vn
# Cổng thanh toán MoMo/VNPay:
#  mock = cổng GIẢ LẬP của website (trang /payment/mock/... có mã QR giả) — dùng để demo, KHÔNG cần khoá merchant
#  live = chỉ bật khi chủ cửa hàng chủ động yêu cầu dùng merchant thật
# Mặc định mọi môi trường là mock để tránh vô tình thu tiền thật.
PAYMENT_MODE=mock
# Production: NODE_ENV=production, SEED_DEMO_DATA=false, JWT_SECRET và JWT_REFRESH_SECRET phải là 2 chuỗi ngẫu nhiên riêng biệt >= 32 ký tự.

# true = khi khởi động backend, tự tạo dữ liệu mẫu nếu bảng còn TRỐNG: 4 voucher mặc định, tin tức mẫu,
# và (ở chế độ mock) bật MoMo / VNPay / chuyển khoản. Không ghi đè dữ liệu đã có. Production nên đặt false.
SEED_DEMO_DATA=true

VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret

# MoMo sandbox — đăng ký tại https://developers.momo.vn
MOMO_PARTNER_CODE=your_partner_code
MOMO_ACCESS_KEY=your_access_key
MOMO_SECRET_KEY=your_secret_key

# Seed dữ liệu demo (chỉ bật tại local dev; endpoint sẽ xóa dữ liệu hiện có)
# Chỉ bật khi bạn chắc chắn DATABASE_URL trỏ đúng database thử nghiệm.
# ENABLE_DEV_SEED=true
# DEV_SEED_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# SEED_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD_AT_LEAST_12_CHARS
